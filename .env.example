# Copia este archivo a .env.local (no se sube a git) o carga estas variables en Vercel.
# Nunca pegues claves reales en el código ni en el chat.

# URL pública del sitio, sin slash final.
SITE_URL=https://frioaustralspa.cl

# ---------- Supabase (cuentas, chat, accesos) ----------
SUPABASE_URL=https://kgxwjywupnnvceyziymj.supabase.co
# Pública (va al navegador vía /api/public-config).
SUPABASE_ANON_KEY=
# SECRETA: solo servidor. En Vercel márcala como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Hotmart (webhook /api/hotmart/webhook) ----------
# Token (hottok) de Hotmart → Herramientas → Webhook. SECRETO: márcalo como Sensitive en Vercel.
HOTMART_HOTTOK=
# Opcional: corrige el mapeo producto/oferta → plan si el primer aviso real llega como "Producto sin plan".
# JSON: {"<data.product.id | data.product.ucode | data.purchase.offer.code>": "basico|pro|premium"}
HOTMART_PLAN_MAP=

# ---------- Panel del equipo ----------
# Emails (separados por coma) que pueden entrar a equipo.html y contenido.html. Deben tener usuario en Supabase Auth.
ADMIN_EMAILS=

# Copia este archivo a .env.local (no se sube a git) o carga estas variables en Vercel.
# Nunca pegues claves reales en el código ni en el chat.

# ---------- Flow (suscripción mensual con cobro automático) ----------
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Sandbox por defecto. Para cobrar de verdad: https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api
# Opcional: prefijo de los planes en Flow (fa-basico-5000, fa-pro-10000, fa-premium-20000).
FLOW_PLAN_PREFIX=fa

# URL pública del sitio, sin slash final (retorno de tarjeta y webhook de Flow).
SITE_URL=https://www.frioaustral.cl

# ---------- Supabase (cuentas, chat, pagos) ----------
SUPABASE_URL=https://akanruuybegwxfjxdpub.supabase.co
# Pública (va al navegador vía /api/public-config).
SUPABASE_ANON_KEY=
# SECRETA: solo servidor. En Vercel márcala como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Panel del equipo ----------
# Emails (separados por coma) que pueden entrar a equipo.html. Deben tener usuario en Supabase Auth.
ADMIN_EMAILS=

# ---------- Cron diario de resincronización con Flow ----------
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>". Usa un valor largo y aleatorio.
CRON_SECRET=

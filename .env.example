# Flow.cl — sandbox por defecto. No subas claves reales a git.
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Opcional. Si no se define, se usa sandbox:
#   sandbox:     https://sandbox.flow.cl/api
#   producción:  https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api
# Alternativa a FLOW_API_URL:
FLOW_ENV=sandbox

# URL pública del sitio, sin slash final. Se usa en el retorno y el webhook de Flow.
SITE_URL=http://localhost:4173

# TODO: confirmar con Mathias/Guillermo antes de cobrar.
# Montos en CLP, sin puntos ni símbolo. Ejemplo (precios de la maqueta actual, NO confirmados):
# FLOW_PLAN_AMOUNTS=basico:5000,pro:10000,premium:20000
FLOW_PLAN_AMOUNTS=

# one_time = pago único (implementado).
# subscription = cobro mensual recurrente (requiere crear planes en la cuenta de Flow; no está armado).
# TODO: confirmar si la suscripción es mensual recurrente o un pago puntual.
FLOW_BILLING_TYPE=one_time

# Opcional. Link o número de WhatsApp que se muestra después de un pago exitoso.
# Ejemplo: https://wa.me/569XXXXXXXX?text=Hola%2C%20pagué%20la%20suscripción
FLOW_SUCCESS_WHATSAPP=

# La Academia se apaga/enciende principalmente en assets/fa-config.js (ACADEMIA_ENABLED).
ACADEMIA_ENABLED=false
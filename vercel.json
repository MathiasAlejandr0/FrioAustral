{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/admin", "destination": "/equipo.html", "permanent": false },
    { "source": "/admin.html", "destination": "/equipo.html", "permanent": false },
    { "source": "/contenido", "destination": "/equipo.html#/paginas/inicio", "permanent": false },
    { "source": "/contenido.html", "destination": "/equipo.html#/paginas/inicio", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(mi-cuenta|equipo|admin|contenido).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
